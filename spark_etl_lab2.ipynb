#!/usr/bin/env python
# coding: utf-8

# In[1]:


import os
os.environ['PYSPARK_SUBMIT_ARGS'] = '--packages org.postgresql:postgresql:42.6.0,com.clickhouse:clickhouse-jdbc:0.4.6 pyspark-shell'

from pyspark.sql import SparkSession
spark = SparkSession.builder.appName("Lab2_Final_Fix").getOrCreate()

pg_url = "jdbc:postgresql://lab2_postgres:5432/abd_snowflake_db"
pg_props = {"user": "adm", "password": "4321", "driver": "org.postgresql.Driver"}

ch_ip = "172.19.0.4" 
ch_url = f"jdbc:clickhouse://{ch_ip}:8123/reports_db"
ch_props = {
    "user": "default", 
    "password": "4321", 
    "driver": "com.clickhouse.jdbc.ClickHouseDriver",
    "compress": "false",
    "ssl": "false"
}

print("--- 1. Загрузка данных из Postgres ---")
spark.read.jdbc(pg_url, "fact_sales", properties=pg_props).createOrReplaceTempView("fact_sales")
spark.read.jdbc(pg_url, "dim_products", properties=pg_props).createOrReplaceTempView("dim_products")
spark.read.jdbc(pg_url, "dim_customers", properties=pg_props).createOrReplaceTempView("dim_customers")
spark.read.jdbc(pg_url, "dim_stores", properties=pg_props).createOrReplaceTempView("dim_stores")
spark.read.jdbc(pg_url, "dim_suppliers", properties=pg_props).createOrReplaceTempView("dim_suppliers")
spark.read.jdbc(pg_url, "raw_data_import", properties=pg_props).createOrReplaceTempView("raw_data")

def write_to_ch(df, table_name):
    df.write.jdbc(url=ch_url, table=table_name, mode="overwrite", properties=ch_props)

print("--- 2. Генерация 6 отчетов ---")

r1 = spark.sql("SELECT p.product_name, p.category, SUM(CAST(f.quantity AS INT)) as total_sold, SUM(CAST(f.total_price AS DECIMAL(12,2))) as total_revenue FROM fact_sales f JOIN dim_products p ON f.product_id = p.product_id GROUP BY 1, 2 ORDER BY 4 DESC")
write_to_ch(r1, "report_1_products")
print("Отчет 1 в ClickHouse")

r2 = spark.sql("SELECT c.first_name, c.last_name, c.country, SUM(CAST(f.total_price AS DECIMAL(12,2))) as total_spent FROM fact_sales f JOIN dim_customers c ON f.customer_id = c.customer_id GROUP BY 1, 2, 3 ORDER BY 4 DESC")
write_to_ch(r2, "report_2_customers")
print("Отчет 2 в ClickHouse")

r3 = spark.sql("SELECT YEAR(sale_date) as yr, MONTH(sale_date) as mon, SUM(CAST(total_price AS DECIMAL(12,2))) as rev FROM fact_sales GROUP BY 1, 2 ORDER BY 1, 2")
write_to_ch(r3, "report_3_time")
print("Отчет 3 в ClickHouse")

r4 = spark.sql("SELECT s.store_name, s.city, SUM(CAST(f.total_price AS DECIMAL(12,2))) as rev FROM fact_sales f JOIN dim_stores s ON f.store_id = s.store_id GROUP BY 1, 2 ORDER BY 3 DESC")
write_to_ch(r4, "report_4_stores")
print("Отчет 4 в ClickHouse")

r5 = spark.sql("SELECT sup.supplier_name, SUM(CAST(f.total_price AS DECIMAL(12,2))) as rev FROM fact_sales f JOIN dim_products p ON f.product_id = p.product_id JOIN dim_suppliers sup ON p.supplier_id = sup.supplier_id GROUP BY 1 ORDER BY 2 DESC")
write_to_ch(r5, "report_5_suppliers")
print("Отчет 5 в ClickHouse")

r6 = spark.sql("SELECT product_name, AVG(CAST(product_rating AS FLOAT)) as rating FROM raw_data GROUP BY 1 ORDER BY 2 DESC")
write_to_ch(r6, "report_6_quality")
print("Отчет 6 в ClickHouse")

print("--- Все отчеты в ClickHouse. ---")

